# Copy this file to .env and put your NEW Gemini API key in .env.
# Never commit .env or put API keys in frontend/VITE_ variables.
GEMINI_API_KEY=replace_with_your_new_server_side_key
GEMINI_MODEL=gemini-2.5-flash

# Optional: set this only if your deployment requires an explicit public URL.
# APP_URL=http://localhost:3000
